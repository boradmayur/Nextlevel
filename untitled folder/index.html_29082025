<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>We’re Launching Soon</title>
  <meta name="description" content="Our site is currently under Maintenance. Stay tuned—we’ll be back soon!" />
  <meta property="og:title" content="We’re Launching Soon" />
  <meta property="og:description" content="Our site is currently under Maintenance. Stay tuned—we’ll be back soon!" />
  <meta name="theme-color" content="#0ea5e9" />
  <style>
    :root{
      --bg: #0b1220;         /* deep navy */
      --panel: #0f172a;      /* slate */
      --accent: #38bdf8;     /* sky */
      --accent-2:#f0f9ff;    /* light */
      --text: #e5e7eb;       /* slate-200 */
      --muted:#94a3b8;       /* slate-400 */
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      display:grid;
      place-items:center;
      background: #fff;
      font: 16px/1.6 system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji";
      padding:24px;
    }
    .card{
      text-align:center;
      position:relative;
      overflow:hidden;
    }
    h1{
      margin:0 0 .4em;
      font-weight:800;
      letter-spacing:.2px;
      font-size: 40px;
      color: #00a44f;
    }
    p{margin:.5em 0 1.25em;color:#333;font-size:25px}
    .tag{
      display:inline-flex; align-items:center; gap:.5ch;
      padding:.4rem .7rem; border:1px solid rgba(56,189,248,.35);
      background: rgba(56,189,248,.08);
      color:var(--accent-2); border-radius:999px; font-weight:600; font-size:.85rem;
    }
    .pulse{
      width:8px; height:8px; border-radius:999px; background:var(--accent);
      box-shadow:0 0 0 0 rgba(56,189,248,.7); animation:pulse 1.8s infinite;
    }
    @keyframes pulse{to{box-shadow:0 0 0 18px rgba(56,189,248,0)}}

    .cta{
      display:inline-block; margin-top:10px; text-decoration:none;
      padding:.9rem 1.1rem; border-radius:14px;
      background: var(--accent);
      color:#00131a; font-weight:700;
      transition: transform .08s ease;
    }
    .cta:active{transform:translateY(1px)}

    footer{margin-top:1.25rem; font-size:.85rem; color:var(--muted)}
    .row{display:flex; gap:12px; justify-content:center; flex-wrap:wrap}
  </style>
</head>
<body>
  <main class="card" role="main" aria-labelledby="title">
    <h1 id="title">Our site is currently under Maintenance</h1>
    <p>Stay tuned—we’ll be back soon!</p>

    <!-- Optional: Email link or placeholder action -->
    <!-- <a class="cta" href="mailto:hello@example.com">Notify Me</a> -->

    <!-- <footer>
      © <span id="year"></span> Your Company. All rights reserved.
    </footer> -->
  </main>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>
</html>

